// Native macOS host and Fritz!Box metrics. Host identity is supplied by the installer.
// Credentials are supplied through the launchd wrapper environment.

prometheus.exporter.unix "host" {
  enable_collectors = [
    "boottime",
    "cpu",
    "diskstats",
    "filesystem",
    "loadavg",
    "meminfo",
    "netdev",
    "uname",
    "textfile",
  ]
  textfile {
    directory = sys.env("ALLOY_TEXTFILE_DIRECTORY")
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "instance"
    replacement  = sys.env("ALLOY_HOST_NAME")
  }

  rule {
    target_label = "source"
    replacement  = "host"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  job_name        = "integrations/host"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana.receiver]
}

prometheus.scrape "cloudflared" {
  targets = [{
    "__address__" = "127.0.0.1:20241",
  }]
  job_name        = "integrations/cloudflared"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana.receiver]
}

prometheus.scrape "fritzbox" {
  targets = [{
    "__address__" = "127.0.0.1:9787",
    "instance"    = "fritzbox-6660",
    "device"      = "fritzbox",
  }]
  job_name        = "integrations/fritzbox"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana.receiver]
}

prometheus.remote_write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_REMOTE_WRITE_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }

  external_labels = {
    "cluster" = sys.env("ALLOY_CLUSTER_NAME"),
    "host"    = sys.env("ALLOY_HOST_NAME"),
    "source"  = "host",
  }
}
