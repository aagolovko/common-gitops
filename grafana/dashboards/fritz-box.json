{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Fritz!Box reachable",
      "id": 1,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "max(fritz_device_reachable)", "legendFormat": ""}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Offline", "color": "red"}, "1": {"text": "Online", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "value"}
    },
    {
      "type": "table",
      "title": "Home Network Devices",
      "id": 2,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "max by (hostname, ip_address, model) (fritz_host_speed) and on (hostname, ip_address, model) (max by (hostname, ip_address, model) (fritz_host_active) == 1)", "format": "table", "instant": true, "legendFormat": ""}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "friendly_name": true, "interface": true, "mac_address": true, "port": true, "serial": true}, "indexByName": {"hostname": 0, "ip_address": 1, "model": 2, "Value": 3}, "renameByName": {"hostname": "Hostname", "ip_address": "IP address", "model": "Model", "Value": "Throughput (Mbit/s)"}}}],
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}, "sortBy": [{"displayName": "Hostname", "desc": false}]}
    },
    {
      "type": "stat",
      "title": "Router uptime",
      "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "max(fritz_uptime_seconds_total)", "legendFormat": ""}],
      "fieldConfig": {"defaults": {"unit": "dtdurations"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Update available",
      "id": 4,
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "max(fritz_update_available)", "legendFormat": ""}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "No", "color": "green"}, "1": {"text": "Yes", "color": "orange"}}}], "unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto"}
    },
    {
      "type": "table",
      "title": "Router public IP",
      "id": 9,
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "max by (ip) (fritz_external_ip_info{ip!=\"\"})", "format": "table", "instant": true, "legendFormat": ""}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true}, "indexByName": {"ip": 0}, "renameByName": {"ip": "Public IP"}}}],
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}
    },
    {
      "type": "timeseries",
      "title": "WAN throughput",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [
        {"refId": "A", "expr": "fritz_wan_datarate_bytes{direction=\"rx\"} * 8 / 1000000", "legendFormat": "Received"},
        {"refId": "B", "expr": "fritz_wan_datarate_bytes{direction=\"tx\"} * 8 / 1000000", "legendFormat": "Transmitted"}
      ],
      "fieldConfig": {"defaults": {"unit": "Mbits", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "LAN throughput",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [
        {"refId": "A", "expr": "rate(fritz_lan_data_bytes_total{direction=\"rx\"}[5m]) * 8 / 1000000", "legendFormat": "Received"},
        {"refId": "B", "expr": "rate(fritz_lan_data_bytes_total{direction=\"tx\"}[5m]) * 8 / 1000000", "legendFormat": "Transmitted"}
      ],
      "fieldConfig": {"defaults": {"unit": "Mbits", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "Wi-Fi associations",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "fritz_wifi_associations_count{enabled=\"1\"}", "legendFormat": "{{wifi_name}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 20, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "Mesh backhaul rate",
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [
        {"refId": "A", "expr": "fritz_mesh_link_current_data_rate_kbps{direction=\"rx\"}", "legendFormat": "{{node}} received"},
        {"refId": "B", "expr": "fritz_mesh_link_current_data_rate_kbps{direction=\"tx\"}", "legendFormat": "{{node}} transmitted"}
      ],
      "fieldConfig": {"defaults": {"unit": "Kbits", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["fritzbox", "network"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"]},
  "timezone": "browser",
  "title": "Fritz!Box Network",
  "uid": "fritz-box-network",
  "version": 1
}
