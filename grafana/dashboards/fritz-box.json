{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Fritz!Box reachable",
      "id": 1,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "fritz_device_reachable", "legendFormat": "{{friendly_name}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Offline", "color": "red"}, "1": {"text": "Online", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Known devices",
      "id": 2,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "fritz_known_devices_count", "legendFormat": "Devices"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Router uptime",
      "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "fritz_uptime_seconds_total", "legendFormat": "{{modelname}}"}],
      "fieldConfig": {"defaults": {"unit": "dtdurations"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Update available",
      "id": 4,
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "fritz_update_available", "legendFormat": "{{friendly_name}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "No", "color": "green"}, "1": {"text": "Yes", "color": "orange"}}}], "unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto"}
    },
    {
      "type": "timeseries",
      "title": "WAN throughput",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [
        {"refId": "A", "expr": "fritz_wan_datarate_bytes{direction=\"rx\"}", "legendFormat": "Received"},
        {"refId": "B", "expr": "fritz_wan_datarate_bytes{direction=\"tx\"}", "legendFormat": "Transmitted"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "LAN throughput",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [
        {"refId": "A", "expr": "rate(fritz_lan_data_bytes_total{direction=\"rx\"}[5m])", "legendFormat": "Received"},
        {"refId": "B", "expr": "rate(fritz_lan_data_bytes_total{direction=\"tx\"}[5m])", "legendFormat": "Transmitted"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "Wi-Fi associations",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [{"refId": "A", "expr": "fritz_wifi_associations_count{enabled=\"1\"}", "legendFormat": "{{wifi_name}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 20, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "Mesh backhaul rate",
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "targets": [
        {"refId": "A", "expr": "fritz_mesh_link_current_data_rate_kbps{direction=\"rx\"}", "legendFormat": "{{node}} received"},
        {"refId": "B", "expr": "fritz_mesh_link_current_data_rate_kbps{direction=\"tx\"}", "legendFormat": "{{node}} transmitted"}
      ],
      "fieldConfig": {"defaults": {"unit": "Kbits", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["fritzbox", "network", "m2host"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"]},
  "timezone": "browser",
  "title": "Fritz!Box Network",
  "uid": "fritz-box-network",
  "version": 1
}
